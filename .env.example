# AEGIS server configuration — copy to .env or export in your shell

# HTTP
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8787

# Where DuckDB + SQLite persist
AEGIS_DATA_DIR=./data

# Real-world discovery (optional)
# GitHub org scanned by the `github` collector (public repos work tokenless;
# org secrets require a fine-grained token with actions:secrets read)
AEGIS_GITHUB_ORG=vercel
AEGIS_GITHUB_TOKEN=

# CLI default server
AEGIS_BASE_URL=http://localhost:8787