{
  "name": "aegis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "aegis": "./scripts/aegis.mjs",
    "aegis-agents": "./scripts/aegis-agents.mjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "server": "tsx server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "start": "npm run build && tsx server/src/index.ts",
    "agents": "node scripts/aegis-agents.mjs",
    "test": "npm run test:engine && npm run test:server",
    "test:engine": "node --import tsx --test src/engine/graph.test.ts",
    "test:server": "node --test server/test/api.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apache-arrow/ts": "^21.2.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@noble/post-quantum": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "fastify": "^5.12.0",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
